# ---- AniList data ------------------------------------------------------------
# interactions.csv is 11 GB, and GitHub refuses files over 100 MB. Share it with
# teammates some other way; they put it in BIPN/data/AniList/.
# Everything else in BIPN/data/AniList is made from the CSV by
# setup_and_train_anilist.bat (same split for everyone: the seed is fixed), so
# only the converter is kept.
BIPN/data/AniList/*
!BIPN/data/AniList/data_process.py
# Converted variants: the grid-search sample, likes only, recently_read cut-offs.
BIPN/data/AniList_*/

# ---- Training output ---------------------------------------------------------
# Saved progress and trained models, training logs, grid-search ranking.
# Each teammate's runs write their own.
check_point/
log/
grid_search_results.csv
*_search_results.csv
*_search_best.json
# LightGCN baseline: its grid-search results and the preprocessed CSV data.
LightGCN/results*/
LightGCN/cache/

# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/

# ---- System and editor files -------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
